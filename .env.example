# ============================================
# Lenny Growth Assistant Configuration
# ============================================

# Application
APP_NAME=Lenny Growth Assistant
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
# Docker Compose exposes PostgreSQL on host port 5433.
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5433/lenny_assistant

# LLM Provider
# Supported values:
#   ollama
#   anthropic
DEFAULT_LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM
# Leave empty when using Ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000