# ============================================
# Lenny Growth Assistant Configuration
# ============================================

# Application
APP_NAME=Lenny Growth Assistant
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# LLM Provider
DEFAULT_LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000